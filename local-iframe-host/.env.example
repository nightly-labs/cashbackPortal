# Bring portal bootstrap endpoint.
# Endpoint used with the local portal.
# Replace this with the Bring dev/staging endpoint if you receive one.
VITE_PORTAL_API=https://api.bringweb3.io/v1/extension/check/portal

# Partner API key issued by Bring. Sent as the x-api-key header.
VITE_PORTAL_API_KEY=replace-me

# Optional. Use only if Bring told you to pass your extension/partner identifier
# in the extensionId field, or when you test the Bring Chrome extension kit flow.
VITE_PORTAL_EXTENSION_ID=

# Optional starting wallet address for local mock-wallet tests.
VITE_PORTAL_WALLET=

# Optional UI theme sent to bootstrap: light, dark, or empty.
VITE_PORTAL_THEME=dark

# Local URL of the portal app started from the repo root with `yarn dev`.
# The host keeps the token from Bring's portalUrl but loads this local app.
VITE_PORTAL_LOCAL_URL=http://localhost:5173
